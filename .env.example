# ── LLM provider keys (server-side only) ─────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Optional: OpenAI-compatible base URL (Together, Groq, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Server ────────────────────────────────────────────────
PORT=4020
# Must exactly match the origin callers reach you on. x402 payment requirements
# embed the resource URL, so a mismatch makes every signature fail to match.
PAYAI_PUBLIC_URL=http://localhost:4020

# ── Billing (USD) ─────────────────────────────────────────
PAYAI_INITIAL_BALANCE_USD=0.05
PAYAI_TOPUP_USD=0.10
PAYAI_TOPUP_CREDIT_USD=0.10

# ── x402 settlement ───────────────────────────────────────
# The facilitator verifies signatures and broadcasts settlement on your behalf.
# QuickNode is NOT a facilitator — it does not expose /verify or /settle for
# third-party resource servers. Use x402.org for testnet, or Coinbase CDP /
# your own facilitator for mainnet.
X402_FACILITATOR_URL=https://x402.org/facilitator

# Where your revenue lands. Setting either one turns demo mode off by default.
PAYAI_EVM_PAY_TO=0xYourBaseSepoliaAddress
# PAYAI_SVM_PAY_TO=YourSolanaDevnetAddress

# ── Onchain verification (QuickNode) ──────────────────────
# Reads the chain to confirm the facilitator's settlement actually happened:
# right token, right recipient, right amount. Without this, receipts are only
# as trustworthy as the facilitator's word. Verification runs in the background
# and never blocks or gates a top-up.
#
# Option 1 — authenticated endpoint (recommended). Base Sepolia, from your
# QuickNode dashboard. The URL contains a credential; keep it out of git.
# PAYAI_QUICKNODE_RPC_URL=https://<endpoint>.base-sepolia.quiknode.pro/<token>/
# Which chain that endpoint serves — one URL cannot answer for two chains.
# PAYAI_QUICKNODE_RPC_NETWORK=eip155:84532
#
# Option 2 — pay QuickNode per RPC call over x402. PayAI becomes a buyer using
# the same protocol it sells with: no API key on the request path. Needs a
# funded testnet key, separate from PAYAI_EVM_PAY_TO above.
# PAYAI_QUICKNODE_X402=true
# PAYAI_QUICKNODE_X402_KEY=0xYourFundedTestnetPrivateKey
# PAYAI_QUICKNODE_X402_NETWORK=eip155:84532
#
# Set false only for offline development.
# PAYAI_VERIFY_SETTLEMENTS=true

# ── Testing the payer side ────────────────────────────────
# Used by `npm run pay` to sign a real top-up. Throwaway testnet key only:
#   npm run keygen                  → generate one
#   https://faucet.circle.com       → fund it with Base Sepolia USDC
# No ETH needed; x402 uses gasless EIP-3009 transfers.
# PAYAI_PAYER_PRIVATE_KEY=0x...

# Use the fake Anthropic provider. Set to false to proxy the real API.
PAYAI_MOCK_ANTHROPIC=true

# ── Onchain verification (QuickNode) ──────────────────────
# Independently confirm that a settlement the facilitator reported actually
# moved USDC to your pay-to address. Without it, receipts read 'unverifiable'.
# PAYAI_QUICKNODE_RPC_URL=https://<your-endpoint>.quiknode.pro/<key>/
# One endpoint serves one chain — declare which.
PAYAI_QUICKNODE_RPC_NETWORK=eip155:84532
# Alternatively, pay QuickNode per RPC call over x402 instead of holding a key.
# PAYAI_QUICKNODE_X402=true
# PAYAI_QUICKNODE_X402_KEY=0x...
PAYAI_VERIFY_SETTLEMENTS=true

# ── Abuse controls ────────────────────────────────────────
# Wallets allowed to claim the free starting balance on this instance.
# Past the cap, new wallets open at $0 and must pay via x402.
PAYAI_MAX_FREE_WALLETS=500
# Demo credits a single wallet may mint via /simulate-fund (demo mode only).
PAYAI_MAX_SIMULATED_TOPUPS=10
# Bearer token required to list every wallet on GET /api/wallet.
# PAYAI_ADMIN_TOKEN=
# Explicitly disable the /simulate-fund money button once you accept real funds.
# PAYAI_DEMO_MODE=false
