# ── LLM provider keys (server-side only) ─────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Optional: OpenAI-compatible base URL (Together, Groq, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1

# ── Server ────────────────────────────────────────────────
PORT=4020
PAYAI_PUBLIC_URL=http://localhost:4020

# ── Billing (USD) ─────────────────────────────────────────
PAYAI_INITIAL_BALANCE_USD=0.05
PAYAI_TOPUP_USD=0.10
PAYAI_TOPUP_CREDIT_USD=0.10

# ── x402 settlement (QuickNode / x402.org facilitator) ───
X402_FACILITATOR_URL=https://x402.org/facilitator
PAYAI_EVM_PAY_TO=0xYourBaseSepoliaAddress
PAYAI_SVM_PAY_TO=YourSolanaDevnetAddress

# Use the fake Anthropic provider. Set to false to proxy the real API.
PAYAI_MOCK_ANTHROPIC=true

# ── Abuse controls ────────────────────────────────────────
# Wallets allowed to claim the free starting balance on this instance.
# Past the cap, new wallets open at $0 and must pay via x402.
PAYAI_MAX_FREE_WALLETS=500
# Demo credits a single wallet may mint via /simulate-fund (demo mode only).
PAYAI_MAX_SIMULATED_TOPUPS=10
# Bearer token required to list every wallet on GET /api/wallet.
# PAYAI_ADMIN_TOKEN=
